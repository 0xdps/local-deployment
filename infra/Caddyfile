:80 {
  @health path /health
  handle @health {
    reverse_proxy backend:3000
  }

  @api path /api/*
  handle @api {
    reverse_proxy backend:3000
  }

  handle /admin* {
    uri strip_prefix /admin
    reverse_proxy admin:80
  }

  handle {
    reverse_proxy frontend:80
  }

  log {
    output stdout
    format console
  }
}
